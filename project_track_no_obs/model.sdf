<?xml version="1.0" ?>
<sdf version="1.5">
  <model name="Track without obstacles">
  <!-- Make the model immovable (no physics integration) -->
    <static>true</static>
    <link name="link">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>1000.0</mass>
        <inertia>
          <ixx>1000.0</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1000.0</iyy>
          <iyz>0</iyz>
          <izz>1000.0</izz>
        </inertia>
      </inertial>

      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://project_track_no_obs/meshes/project_track_no_obs.dae</uri>
          </mesh>
        </geometry>
      </visual>

      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://project_track_no_obs/meshes/project_track_no_obs.dae</uri>
          </mesh>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
